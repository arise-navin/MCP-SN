# Required to use the corresponding optional field; no universal defaults.
SERVICENOW_INCIDENT_STATES=[]
SERVICENOW_INCIDENT_CATEGORIES=[]

# Server-side settings for the built-in chat host.
OLLAMA_API_KEY=replace-with-your-ollama-cloud-api-key
OLLAMA_MODEL=replace-with-a-tool-capable-cloud-model
CHAT_PASSWORD=replace-with-a-private-password-at-least-16-characters
